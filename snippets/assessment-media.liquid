
{% liquid
  assign media_image = block.settings.media_image
  assign media_video = block.settings.media_video
%}

<div class="assessment-media">
  {% if media_video != blank %}
    {{
      media_video
      | video_tag:
        controls: true,
        autoplay: false,
        image_size: '1200x'
    }}
  {% elsif media_image != blank %}
    {{
      media_image
      | image_url: width: 1600
      | image_tag:
        loading: 'lazy',
        widths: '375, 550, 750, 1100, 1500, 1600',
        sizes: '(min-width: 750px) 100vw, 100vw'
    }}
  {% else %}
    <p>Please select an image or video.</p>
  {% endif %}
</div>

{% comment %}
  Media button: display only when label and link are provided.
{% endcomment %}
{% if block.settings.button_label != blank and block.settings.button_link != blank %}
  <a
    href="{{ block.settings.button_link }}"
    class="assessment-media__button"
  >
    {{ block.settings.button_label | escape }}
  </a>
{% endif %}
